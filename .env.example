# Orion Environment Configuration

# Environment mode: development | production
ENVIRONMENT=development

# JWT Secret Key (required in production; minimum 32 characters)
JWT_SECRET=
# Legacy alias for JWT_SECRET:
# RAILOPT_SECRET=

# Database Connection (Neon PostgreSQL recommended for production; defaults to SQLite if empty)
# Format: postgresql+psycopg://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS Allowed Origins (comma-separated; defaults to localhost:3000, localhost:5173 for dev)
CORS_ORIGINS=

# RailRadar API Integration
# Comma-separated list of RailRadar API keys
RAILRADAR_API_KEYS=
RAILRADAR_BASE_URL=https://api.railradar.in/v1
# Offline mode: 1 = never call network, read snapshots from data/railradar_snapshots/
RAILRADAR_OFFLINE=0
# Safe monthly limit per key (default: 90)
RAILRADAR_KEY_LIMIT=90

# LLM Integration (NVIDIA-hosted or Gemini)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_API_KEY=
